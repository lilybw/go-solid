FROM golang:1.27-alpine3.24

WORKDIR /go-solid

# Make sure to update and maintain .dockerignore
# Alsdo build ctx is set to go-solid dir in docker-compose
COPY . . 

COPY package.json .

# compile-check at build time
RUN ["go", "build", "./..." ]         
# tests run at container start# tests run at container start; capture output, never fail the container
CMD go test ./... > /logs/test-log.txt 2>&1; echo "exit: $?" >> /logs/test-log.txt