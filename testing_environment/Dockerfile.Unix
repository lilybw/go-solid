FROM golang:1.27-alpine3.24

WORKDIR /go-solid

# Build ctx is set to the go-solid dir in docker-compose
COPY . . 

# Compile-check at build time, the library and every scenario module.
#
# The tidy resolves each scenario's own dependencies, which the library's go.mod
# deliberately does not carry. Swap it for `go mod download` once every scenario
# ships a go.sum.
RUN go build ./... && \
	for manifest in testing_environment/scenarios/*/go.mod; do \
		[ -f "$manifest" ] || continue; \
		(cd "$(dirname "$manifest")" && go mod tidy && go build ./...) || exit 1; \
	done

# Tests run at container start; capture output, never fail the container
CMD sh testing_environment/test-all.sh > /logs/test-log.txt 2>&1
